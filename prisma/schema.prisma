datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pesquisador {
  id         String      @id
  nome       String
  telefone   String
  createdAt  DateTime    @default(now()) @map("created_at")
  auditorias Auditoria[]

  @@map("pesquisadores")
}

model Loja {
  id            String     @id
  rede          String
  nome          String
  endereco      String
  estacaoMetro  String?    @map("estacao_metro")
  cnpj          String     @unique
  cnpjFormatado String     @map("cnpj_formatado")
  status        String     @default("PENDENTE")
  auditadaEm    DateTime?  @map("auditada_em")
  pesquisadorId String?    @map("pesquisador_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  auditoria     Auditoria?

  @@index([rede])
  @@index([status])
  @@index([cnpj])
  @@map("lojas")
}

model Auditoria {
  id                      String      @id @default(cuid())
  lojaId                  String      @unique @map("loja_id")
  pesquisadorId           String      @map("pesquisador_id")
  statusEntrada           String      @map("status_entrada")
  justificativaInoperante String?     @map("justificativa_inoperante")

  existeGeladeira         Boolean?    @map("existe_geladeira")
  marcaVisualGeladeira    String?     @map("marca_visual_geladeira")
  posseGeladeira          String?     @map("posse_geladeira")
  // A coluna organizacao_geladeira sempre guardou o nível de abastecimento (Cheia ... Quase vazia)
  abastecimentoGeladeira  String?     @map("organizacao_geladeira")
  organizacaoGeladeira    String?     @map("organizacao")
  visibilidadeMarcas      String?     @map("visibilidade_marcas")

  monsterPresente         Boolean?    @map("monster_presente")
  monsterNaGeladeira      Boolean?    @map("monster_na_geladeira")
  marcasCocaPresentes     String?     @map("marcas_coca_presentes")
  // JSON: [{ categoria, tem, marcas, concorrentes }]
  mapaBebidas             String?     @map("mapa_bebidas") @db.Text

  concorrentesMisturados  Boolean?    @map("concorrentes_misturados")
  concorrentesDetalhes    String?     @map("concorrentes_detalhes")

  espacoLivreCaixa        Boolean?    @map("espaco_livre_caixa")
  espacoLadoTamanho       String?     @map("espaco_lado_tamanho")
  espacoDisponivel        String?     @map("espaco_disponivel")
  produtosExpostosCaixa   String?     @map("produtos_expostos_caixa")
  boaVisibilidadeCaixa    Boolean?    @map("boa_visibilidade_caixa")
  outrosDisplaysImpulso   Boolean?    @map("outros_displays_impulso")
  displaysImpulsoMarcas   String?     @map("displays_impulso_marcas")
  displaysImpulsoProximo  Boolean?    @map("displays_impulso_proximo_caixa")
  potencialDisplay        String?     @map("potencial_display")
  descricaoOportunidade   String?     @map("descricao_oportunidade")

  createdAt               DateTime    @default(now()) @map("created_at")

  loja                    Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pesquisador             Pesquisador @relation(fields: [pesquisadorId], references: [id])
  fotos                   Foto[]

  @@index([pesquisadorId])
  @@map("auditorias")
}

model Foto {
  id           String    @id @default(cuid())
  auditoriaId  String    @map("auditoria_id")
  tipo         String
  url          String
  tamanhoBytes Int?      @map("tamanho_bytes")
  base64       String?   @map("base64") @db.Text
  driveFileId  String?   @map("drive_file_id")
  driveUrl     String?   @map("drive_url")
  createdAt    DateTime  @default(now()) @map("created_at")

  auditoria    Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  @@index([auditoriaId])
  @@map("fotos")
}
